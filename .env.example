# Are.na profile used by the main dashboard Sync button and profile card.
# Use a bare slug, e.g. "example-user", or an Are.na profile URL.
ARENA_PROFILE_SLUG=

OPENAI_API_KEY=
# Are.na Personal Access Token (read scope). Optional, but recommended:
# guest tier is 30 req/min and parallel channel fan-out can trip 429.
# Premium tier with a PAT is 300 req/min.
ARENA_TOKEN=

# Optional. Defaults to data/aresearch.db.
SQLITE_PATH=

# Required for the full sync pipeline's Link/Attachment content extraction.
# If omitted, the external-content stage will fail.
JINA_API_KEY=

# Optional. Required only for YouTube transcript extraction if yt-dlp is not on PATH.
YT_DLP_PATH=

# Owner-mode admin auth for /dev.
# Required together: password verifies login, secret signs the httpOnly cookie.
ARESEARCH_ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=
